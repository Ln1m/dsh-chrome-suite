{
    "name": "dsh-archive-button",
    "version": "0.1.0",
    "description": "DSH session archive button: an icon in the official sidebar.footer.action slot (beside Settings) that opens its panel upward. First click dry-runs a scan of DSH sessions idle for more than 3 days; second click packs each into a byte-verified zip and removes the original folder. Uses the vk layout seat when dsh-vk-suite is present. Never triggered by the model.",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": {
            "default": "./lib/index.js"
        },
        "./client": {
            "default": "./lib/client.js"
        },
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "inject": [
                "@deepseek-ai/dsh-client-ui-sidebar",
                "@deepseek-ai/dsh-client-ui-primitives"
            ],
            "platform": "web"
        }
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.1",
        "react": "^18.2.0"
    },
    "files": [
        "lib",
        "cordis.patch.yml",
        "README.md",
        "scripts"
    ],
    "license": "MIT",
    "keywords": [
        "dsh",
        "deepseek-harness",
        "plugin",
        "archive",
        "sessions",
        "sidebar"
    ],
    "author": "Ln1m (https://github.com/Ln1m)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ln1m/dsh-chrome-suite.git",
        "directory": "dsh-archive-button"
    },
    "homepage": "https://github.com/Ln1m/dsh-chrome-suite/tree/main/dsh-archive-button#readme",
    "bugs": {
        "url": "https://github.com/Ln1m/dsh-chrome-suite/issues"
    }
}
